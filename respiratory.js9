/* =========================================
   ADD RESPIRATORY MEDICINES
   TO DOSECARE DATABASE
========================================= */

respiratoryMedicines.forEach(
    medicine => {

        if (
            !medicines.some(
                existingMedicine =>
                    existingMedicine.id ===
                    medicine.id
            )
        ) {

            medicines.push(
                medicine
            );

        }

    }
);
